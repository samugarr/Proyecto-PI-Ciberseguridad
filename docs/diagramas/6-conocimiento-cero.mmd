flowchart TB
    subgraph NAV["Solo en el navegador: nunca llega al servidor"]
        direction LR
        n1["Contraseña p"] ~~~ n2["K_enc"] ~~~ n3["k_u en claro"] ~~~ n4["k_acc"] ~~~ n5["Número de cuenta<br/>completo"]
    end

    subgraph CIF["Llega al servidor cifrado: no tiene la clave para leerlo"]
        direction LR
        c1["k_u cifrada con K_enc<br/>(AES-256-GCM)"] ~~~ c2["Cuenta cifrada con k_acc<br/>(AES-256-GCM)"] ~~~ c3["k_acc cifrada con K_u<br/>(RSA-OAEP)"]
    end

    subgraph HSH["Llega pero solo guarda su hash"]
        h1["K_auth → se guarda Argon2id(K_auth)<br/>no sirve para iniciar sesión si lo roban"]
    end

    subgraph CLR["Llega y se guarda en claro: lo necesita para funcionar"]
        direction LR
        e1["Email<br/>iniciar sesión"] ~~~ e2["Teléfono<br/>buscar destinatario"] ~~~ e3["Nombre y tipo<br/>de usuario"] ~~~ e4["Sal s y<br/>clave pública K_u"] ~~~ e5["4 últimos dígitos<br/>de la cuenta"]
        e6["Transacción:<br/>emisor, receptor y fecha"] ~~~ e7["Transacción:<br/>cantidad y concepto<br/><b>pendiente de cifrar</b>"]
    end

    NAV ~~~ CIF ~~~ HSH ~~~ CLR

